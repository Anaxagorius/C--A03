<Application x:Class="Assignment03.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Assignment03"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Navigation button style used in MainWindow left pane -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A5A8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="EmployeeLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Shared text-box style used by EmployeeInfo -->
        <Style x:Key="EmployeeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#1A3A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Shared button style used by EmployeeInfo -->
        <Style x:Key="EmployeeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A3A5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ── Support Staff styles (intentionally different appearance) ────── -->

        <!-- Label style for SupportStaffInfo -->
        <Style x:Key="SupportLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C1A1A"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- TextBox style for SupportStaffInfo -->
        <Style x:Key="SupportTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#5C1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFF8F8"/>
        </Style>

        <!-- Button style for SupportStaffInfo -->
        <Style x:Key="SupportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Application.Resources>
</Application>
