<!--
    SimpleBindingDemoWindow.xaml – Question 2
    Implements the Microsoft "How to: Create a Simple Binding" tutorial:
    https://learn.microsoft.com/en-us/dotnet/desktop/wpf/data/how-to-create-a-simple-binding?view=netdesktop-9.0

    Key concepts demonstrated:
    ● DataContext  – set in code-behind; tells every {Binding} in this window
                     which object to read properties from.
    ● {Binding}    – XAML markup extension that connects a UI property to a
                     data property.  No event wiring in code-behind needed.
    ● INotifyPropertyChanged – interface implemented by MyData; raises
                     PropertyChanged so WPF knows to refresh the UI the moment
                     MyName changes.
-->
<Window x:Class="Assignment03.Windows.SimpleBindingDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Binding Demo – Question 2"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">

        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
                   Text="Question 2 – Simple Data Binding"/>

        <!-- TextBox: two-way binding so MyData.MyName updates as the user types -->
        <TextBlock Text="Enter your name:" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName"
                 Text="{Binding MyName, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4,3" Margin="0,0,0,12"/>

        <!--
            TextBlock: one-way binding — automatically refreshes whenever
            MyData.MyName changes (thanks to INotifyPropertyChanged).
        -->
        <TextBlock Text="Bound display:" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding MyName}"
                   FontStyle="Italic" Foreground="#1A3A5C"
                   FontSize="14" Margin="0,0,0,16"/>

        <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11">
            <Run FontWeight="Bold">How it works: </Run>
            <Run>DataContext is set to a </Run><Run FontStyle="Italic">MyData</Run>
            <Run> instance in the constructor. Both controls use </Run>
            <Run FontWeight="Bold">{Binding MyName}</Run>
            <Run>. Because </Run><Run FontStyle="Italic">MyData</Run>
            <Run> implements </Run><Run FontWeight="Bold">INotifyPropertyChanged</Run>
            <Run>, WPF updates the TextBlock every time the TextBox changes.</Run>
        </TextBlock>

    </StackPanel>
</Window>
