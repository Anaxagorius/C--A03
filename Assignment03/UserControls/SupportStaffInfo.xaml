<UserControl x:Class="Assignment03.UserControls.SupportStaffInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="400">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Support Staff Information"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#5C1A1A" Margin="0,0,0,16"/>

            <TextBlock Text="First Name" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtFirstName" Style="{StaticResource SupportTextBoxStyle}"/>

            <TextBlock Text="Last Name" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtLastName" Style="{StaticResource SupportTextBoxStyle}"/>

            <TextBlock Text="Employee Code" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtEmployeeCode" Style="{StaticResource SupportTextBoxStyle}"/>

            <TextBlock Text="Department" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtDepartment" Style="{StaticResource SupportTextBoxStyle}"/>

            <TextBlock Text="Email" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource SupportTextBoxStyle}"/>

            <TextBlock Text="Support Area" Style="{StaticResource SupportLabelStyle}"/>
            <TextBox x:Name="TxtSupportArea" Style="{StaticResource SupportTextBoxStyle}"/>

            <!-- Validation error message -->
            <TextBlock x:Name="TxtValidationError"
                       Foreground="Red" FontStyle="Italic"
                       Margin="0,6,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save"
                        Style="{StaticResource SupportButtonStyle}"
                        Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button Content="Cancel"
                        Style="{StaticResource SupportButtonStyle}"
                        Background="#6C757D"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
